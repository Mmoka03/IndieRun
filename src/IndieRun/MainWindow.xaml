<Window x:Class="IndieRun.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IndieRun · 게임 정리" Width="1440" Height="930" MinWidth="1180" MinHeight="780" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="Organize_KeyDown">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#18243C"><DockPanel Margin="10,22">
   <TextBlock DockPanel.Dock="Top" Text="ir." FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,36"/>
   <Button DockPanel.Dock="Bottom" Content="?" Click="Guide_Click" Background="Transparent" Foreground="#CFD9EB" BorderBrush="#46546E" Padding="8,10" ToolTip="사용 가이드" AutomationProperties.Name="사용 가이드"/>
   <StackPanel>
    <Button x:Name="PlayerNav" Content="▶&#10;실행" Click="Player_Click" Background="Transparent" Foreground="#B8C5DC" BorderThickness="0" Padding="9,14" Margin="0,0,0,10"/>
    <Button x:Name="OrganizeNav" Content="▤&#10;정리" Click="Organize_Click" Background="#344D7C" Foreground="White" BorderThickness="0" Padding="9,14"/>
    <Button x:Name="TagsNav" Content="#&#10;태그" Click="Tags_Click" Background="Transparent" Foreground="#B8C5DC" BorderThickness="0" Padding="9,14" Margin="0,10,0,0"/>
    <Button x:Name="LibraryNav" Content="▦&#10;보관함" Click="Library_Click" Background="Transparent" Foreground="#B8C5DC" BorderThickness="0" Padding="9,14" Margin="0,10,0,0"/>
    <Button x:Name="JobsNav" Content="◷&#10;작업" Click="Jobs_Click" Background="Transparent" Foreground="#B8C5DC" BorderThickness="0" Padding="9,14" Margin="0,10,0,0"/>
   </StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition x:Name="FooterRow" Height="84"/></Grid.RowDefinitions>
   <Border Background="{DynamicResource Surface.Primary}" BorderBrush="#E6EBF3" BorderThickness="0,0,0,1" Padding="28,16"><Grid>
    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="게임 정리" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Visibility="Collapsed" Foreground="#7D8799" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="SaveStatus" Content="자동 저장" Click="SaveStatus_Click" BorderThickness="0" Background="Transparent" Foreground="#6A7C99" FontSize="12" Margin="0,0,10,0"/><Button x:Name="RescanButton" Content="다시 검색" Click="Reset_Click" ToolTip="편집 내용을 유지하며 다시 확인합니다."/></StackPanel>
   </Grid></Border>
   <Grid Grid.Row="1" Margin="28,0"><TextBlock x:Name="Notice" VerticalAlignment="Center" Foreground="#647995" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,190,0"/><Button x:Name="ScopeUndoButton" Content="실행 취소" Click="Undo_Click" HorizontalAlignment="Right" Margin="0,0,95,0" Padding="9,4" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Accent.Text}" FontSize="12" Visibility="Collapsed" ToolTip="Ctrl+Z"/><Button Content="도움말 ↗" Click="Guide_Click" HorizontalAlignment="Right" Padding="9,4" BorderThickness="0" Background="Transparent" Foreground="#7185A5" FontSize="12"/></Grid>
   <Grid x:Name="Workbench" Grid.Row="2" Margin="28,0,28,20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Surface.Primary}" CornerRadius="12" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"><DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="18,20,18,16">
      <DockPanel><TextBlock x:Name="CandidateCount" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource Text.Muted}"/><Button DockPanel.Dock="Right" Content="전체 선택" Click="PickAll_Click" Padding="6,3" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text.Secondary}" FontSize="11" Margin="0,0,10,0"/><TextBlock Text="게임 선택" FontSize="16" FontWeight="SemiBold"/></DockPanel>
      <Button x:Name="SourceButton" Content="탐색 위치" Click="Source_Click" Margin="0,14,0,6"/>
      <TextBlock x:Name="ScanSourceLabel" Foreground="{DynamicResource Text.Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="2,0,0,10"/>
      <Button x:Name="ExcludedButton" Visibility="Collapsed" Content="제외 0" Click="Excluded_Click" Padding="7,4" FontSize="11" HorizontalAlignment="Left" Margin="0,0,0,8"/>
      <Grid><TextBox x:Name="Search" TextChanged="Search_Changed" AutomationProperties.Name="후보 검색"/><TextBlock Text="이름 검색" Foreground="{DynamicResource Text.Hint}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     </StackPanel>
     <ScrollViewer x:Name="CandidateScroll"><StackPanel Margin="10,0,10,12"><StackPanel x:Name="CandidateList"/><Expander x:Name="CandidateReviewSection" Header="확인 필요" Foreground="{DynamicResource Text.Muted}" Margin="6,8,6,0" Visibility="Collapsed"><StackPanel x:Name="CandidateReviewList" Margin="0,10,0,0"/></Expander></StackPanel></ScrollViewer>
    </DockPanel></Border>
    <Border Grid.Column="2" Background="{DynamicResource Surface.Primary}" CornerRadius="12" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"><Grid Margin="24">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,18"><DockPanel><Button x:Name="PreviewButton" DockPanel.Dock="Right" Content="내용 보기" Click="Preview_Click" Margin="12,0,0,0"/><TextBlock x:Name="SelectedTitle" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock x:Name="OriginalPath" Foreground="{DynamicResource Text.Muted}" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
     <ScrollViewer Grid.Row="1"><StackPanel>
      <Border x:Name="ReviewBanner" Visibility="Collapsed" Background="{DynamicResource Warning.Surface}" CornerRadius="7" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock x:Name="ReviewMessage" Foreground="{DynamicResource Warning.Text}" TextWrapping="Wrap"/><WrapPanel Margin="0,8,0,0"><Button x:Name="ReviewChangesButton" Content="변경 확인" Click="ReviewChanges_Click" Padding="9,5" Margin="0,0,7,0"/><Button x:Name="LocationReviewButton" Content="탐색 위치" Click="Source_Click" Visibility="Collapsed" Padding="9,5" Margin="0,0,7,0"/><Button x:Name="ReconnectButton" Content="폴더 다시 연결" Click="Reconnect_Click" Padding="9,5"/></WrapPanel></StackPanel></Border>
      <DockPanel Margin="0,0,0,12"><TextBlock x:Name="SelectedState" DockPanel.Dock="Right" Foreground="{DynamicResource Accent.Text}" FontSize="12"/><TextBlock x:Name="PackageLabel" Text="폴더 구조" FontWeight="SemiBold"/></DockPanel>
      <Border x:Name="PackageLayer" Background="{DynamicResource Surface.Primary}" CornerRadius="8"><StackPanel x:Name="TreeRows"/></Border>
     </StackPanel></ScrollViewer>
     <StackPanel Grid.Row="2">
      <WrapPanel x:Name="ScopeActions" Visibility="Collapsed" Margin="0,14,0,0"><Button x:Name="IncludeParentButton" Content="상위 폴더 포함" Click="IncludeParent_Click" Margin="0,0,8,8"/><Button x:Name="ResetScopeButton" Content="이전 범위로" Click="ResetScope_Click" Visibility="Collapsed" Margin="0,0,8,8"/><Button x:Name="ExecutableScopeButton" Content="실행 폴더만" Click="ExecutableScope_Click" Margin="0,0,8,8" Visibility="Collapsed"/></WrapPanel>
      <Border x:Name="OrganizeWarning" Background="{DynamicResource Warning.Surface}" CornerRadius="7" Padding="12" Margin="0,8,0,0" Visibility="Collapsed"><StackPanel><TextBlock x:Name="OrganizeWarningText" Foreground="{DynamicResource Warning.Text}" TextWrapping="Wrap"/><Button x:Name="RetryPortableButton" Content="정보 파일 다시 확인" Click="RetryPortable_Click" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed"/><Button x:Name="RecoverRenameButton" Content="폴더명 변경 복구" Click="RecoverRename_Click" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed"/><Button x:Name="RecoverScopeButton" Content="범위 변경 복구" Click="RecoverScope_Click" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed"/><Button x:Name="AddReviewedButton" Content="이 게임 추가" Click="AddReviewed_Click" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed"/></StackPanel></Border>
      <DockPanel Margin="0,16,0,0"><WrapPanel DockPanel.Dock="Right"><Button Content="⋯" ToolTip="정리 옵션" Click="OrganizeOptions_Click" Margin="0" Padding="10,5" BorderThickness="0" Background="Transparent"/><Button x:Name="EditScopeButton" Content="범위 수정" Click="EditScope_Click" Visibility="Collapsed" Margin="8,0,0,0"/><Button x:Name="OrganizeInfoButton" Content="게임 정보 편집" Click="OrganizeEdit_Click" Visibility="Collapsed" Margin="8,0,0,0"/><Button x:Name="MoveSelectedButton" Content="보관함으로 옮기기" Click="MoveSelected_Click" Visibility="Collapsed" Margin="8,0,0,0"/></WrapPanel><TextBlock x:Name="OrganizeHint" Text="게임을 추가해도 폴더는 이동하지 않습니다." Foreground="{DynamicResource Text.Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/></DockPanel>
     </StackPanel>
    </Grid></Border>
   </Grid>
   <!-- Retained fields for workspace/editor compatibility; these are no longer part of the organize UI. -->
   <StackPanel Visibility="Collapsed"><TextBlock x:Name="StructureSummary"/><TextBox x:Name="Alias" TextChanged="Alias_TextChanged" LostFocus="Alias_Changed"/><TextBox x:Name="PhysicalName" TextChanged="Physical_TextChanged" LostFocus="Physical_Changed"/><TextBlock x:Name="NameWarning"/><WrapPanel x:Name="GenreChecks"/><WrapPanel x:Name="CategoryChecks"/><StackPanel x:Name="GenreCreator"/><StackPanel x:Name="CategoryCreator"/><Button x:Name="ContentToggle"/><Button x:Name="RelationToggle"/><Button x:Name="SplitButton"/><Button x:Name="StageButton"/><TextBlock x:Name="DestinationLabel"/><StackPanel x:Name="PlannedList"/><Border x:Name="DropZone"><TextBlock x:Name="DropTitle"/></Border></StackPanel>
   <Border x:Name="PlayerPanel" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource Surface.Primary}" CornerRadius="12" Margin="28,0,28,20" Padding="24"><DockPanel x:Name="PlayerContent"/></Border>
   <Border x:Name="JobsPanel" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource Surface.Primary}" CornerRadius="12" Margin="28,0,28,20" Padding="28"><DockPanel><StackPanel x:Name="JobsSummary" DockPanel.Dock="Top"/><ScrollViewer><StackPanel x:Name="JobsContent"/></ScrollViewer></DockPanel></Border>
   <Border x:Name="LibraryPanel" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource Surface.Primary}" CornerRadius="12" Margin="28,0,28,20" Padding="28"><ScrollViewer><StackPanel x:Name="LibraryContent"/></ScrollViewer></Border>
   <Border x:Name="TagsPanel" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource Surface.Primary}" CornerRadius="12" Margin="28,0,28,20" Padding="28"><ScrollViewer><StackPanel x:Name="TagsContent"/></ScrollViewer></Border>
   <Border x:Name="PageFooter" Grid.Row="3" Background="{DynamicResource Surface.Primary}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="28,14"><DockPanel><StackPanel x:Name="FooterActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="OpenAddedButton" Style="{StaticResource Primary}" Content="실행 화면에서 보기" Click="OpenAdded_Click" Visibility="Collapsed" Margin="0,0,12,0"/><Button x:Name="ReviewButton" Content="이동 계획 확인" Click="Review_Click" Margin="0,0,12,0" Visibility="Collapsed"/><Button x:Name="ClearPickedButton" Content="선택 해제" Click="ClearPicked_Click" Margin="0,0,12,0" Visibility="Collapsed"/><Button x:Name="MovePickedButton" Content="선택한 게임 옮기기" Style="{StaticResource Primary}" Click="MovePicked_Click" Margin="0,0,12,0" Padding="22,12" Visibility="Collapsed"/><Button x:Name="AddGamesButton" Content="선택한 게임 추가" Style="{StaticResource Primary}" Click="AddGames_Click" Padding="22,12"/><Button x:Name="CancelScopeButton" Content="취소" Click="CancelScope_Click" Margin="0,0,8,0" Visibility="Collapsed"/><Button x:Name="ApplyScopeButton" Content="범위 적용" Click="ApplyScope_Click" Style="{StaticResource Primary}" Padding="22,12" Margin="0" Visibility="Collapsed"/></StackPanel><StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock x:Name="PlanCount" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="PlanHint" Foreground="{DynamicResource Text.Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
  </Grid>
 </Grid>
</Window>

