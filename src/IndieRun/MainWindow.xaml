<Window x:Class="IndieRun.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IndieRun · 게임 정리" Width="1440" Height="930" MinWidth="1180" MinHeight="780" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#18243C"><DockPanel Margin="10,22">
   <TextBlock DockPanel.Dock="Top" Text="ir." FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,36"/>
   <Button DockPanel.Dock="Bottom" Content="?" Click="Guide_Click" Background="Transparent" Foreground="#CFD9EB" BorderBrush="#46546E" Padding="8,10" ToolTip="사용 가이드" AutomationProperties.Name="사용 가이드"/>
   <StackPanel>
    <Button x:Name="OrganizeNav" Content="▤&#10;정리" Click="Organize_Click" Background="#344D7C" Foreground="White" BorderThickness="0" Padding="9,14"/>
    <Button x:Name="TagsNav" Content="#&#10;태그" Click="Tags_Click" Background="Transparent" Foreground="#B8C5DC" BorderThickness="0" Padding="9,14" Margin="0,10,0,0"/>
    <Button x:Name="JobsNav" Content="◷&#10;작업" Click="Jobs_Click" Background="Transparent" Foreground="#B8C5DC" BorderThickness="0" Padding="9,14" Margin="0,10,0,0"/>
   </StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="84"/></Grid.RowDefinitions>
   <Border Background="White" BorderBrush="#E6EBF3" BorderThickness="0,0,0,1" Padding="28,16"><Grid>
    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="게임 정리" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="선택하고, 확인하고, 보관함에 담기" Foreground="#7D8799" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="SaveStatus" Content="자동 저장" Click="SaveStatus_Click" BorderThickness="0" Background="Transparent" Foreground="#6A7C99" FontSize="12" Margin="0,0,10,0"/><Border Background="#EFF3F9" CornerRadius="5" Padding="10,6" Margin="0,0,12,0"><TextBlock Text="백업 후 이동 지원" Foreground="#6A7C99" FontSize="12"/></Border><Button x:Name="RescanButton" Content="다시 검색" Click="Reset_Click" ToolTip="편집 내용을 유지하며 다시 확인합니다."/></StackPanel>
   </Grid></Border>
   <Grid Grid.Row="1" Margin="28,0"><TextBlock x:Name="Notice" VerticalAlignment="Center" Foreground="#647995" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,100,0"/><Button Content="도움말 ↗" Click="Guide_Click" HorizontalAlignment="Right" Padding="9,4" BorderThickness="0" Background="Transparent" Foreground="#7185A5" FontSize="12"/></Grid>
   <Grid x:Name="Workbench" Grid.Row="2" Margin="28,0,28,20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="264"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="278"/></Grid.ColumnDefinitions>
    <Border Background="White" CornerRadius="12" BorderBrush="#E2E7F0" BorderThickness="1"><DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="18,20,18,16">
      <Grid><StackPanel Orientation="Horizontal"><Border Background="#EAF0FC" CornerRadius="6" Width="26" Height="26" Margin="0,0,9,0"><TextBlock Text="1" Foreground="#4269C7" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="게임 선택" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="CandidateCount" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#8A96A8"/></Grid>
      <Button x:Name="SourceButton" Content="＋ 폴더 선택" Click="Source_Click" Margin="0,18,0,6"/>
      <TextBlock x:Name="ScanSourceLabel" Foreground="#8A98AD" FontSize="11" TextTrimming="CharacterEllipsis" Margin="2,0,0,10"/>
      <Button x:Name="ExcludedButton" Visibility="Collapsed" Content="제외 0" Click="Excluded_Click" Padding="7,4" FontSize="11" HorizontalAlignment="Left" Margin="0,0,0,8"/>
      <Grid><TextBox x:Name="Search" TextChanged="Search_Changed" AutomationProperties.Name="후보 검색"/><TextBlock Text="이름 검색" Foreground="#98A3B5" Margin="11,9" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     </StackPanel>
     <ScrollViewer><StackPanel x:Name="CandidateList" Margin="10,0,10,12"/></ScrollViewer>
    </DockPanel></Border>
    <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#CCD9ED" BorderThickness="1"><DockPanel>
     <Border DockPanel.Dock="Bottom" Background="#F7F9FE" Padding="20,14" CornerRadius="0,0,12,12"><Grid><TextBlock x:Name="SelectedState" Text="이동 전 미리보기" VerticalAlignment="Center" Foreground="#8492A8" FontSize="12"/><Button x:Name="StageButton" Content="보관함에 담기 →" Click="Add_Click" HorizontalAlignment="Right" Style="{StaticResource Primary}" Padding="20,11"/></Grid></Border>
     <ScrollViewer><StackPanel Margin="22,20,22,20">
      <Grid><StackPanel Orientation="Horizontal"><Border Background="#EAF0FC" CornerRadius="6" Width="26" Height="26" Margin="0,0,9,0"><TextBlock Text="2" Foreground="#4269C7" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="확인 · 분류" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><Button x:Name="PreviewButton" Content="내용 보기 ↗" HorizontalAlignment="Right" Click="Preview_Click" Padding="10,6"/></Grid>
      <TextBlock x:Name="SelectedTitle" FontSize="22" FontWeight="SemiBold" Margin="0,20,0,0"/>
      <TextBlock x:Name="OriginalPath" Foreground="#8A95A7" FontSize="12" Margin="0,6,0,16" TextTrimming="CharacterEllipsis"/>
      <Border x:Name="ReviewBanner" Visibility="Collapsed" Background="#FFF5E5" CornerRadius="7" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock x:Name="ReviewMessage" Foreground="#9A733F" TextWrapping="Wrap"/><WrapPanel Margin="0,8,0,0"><Button x:Name="ReviewChangesButton" Content="변경 확인" Click="ReviewChanges_Click" Padding="9,5" Margin="0,0,7,0"/><Button x:Name="ReconnectButton" Content="폴더 다시 연결" Click="Reconnect_Click" Padding="9,5"/></WrapPanel></StackPanel></Border>
      <Border x:Name="PackageLayer" Background="#F0F5FF" BorderBrush="#9CB9EF" BorderThickness="1" CornerRadius="8" Padding="14,12"><StackPanel><Grid><TextBlock x:Name="PackageLabel" FontWeight="SemiBold" Foreground="#496EAF" FontSize="12"/><TextBlock Text="이동 범위" HorizontalAlignment="Right" Foreground="#7F95B8" FontSize="11" ToolTip="색 영역에 포함된 폴더 전체를 함께 옮깁니다."/></Grid><StackPanel x:Name="TreeRows" Margin="0,9,0,0"/></StackPanel></Border>
      <TextBlock x:Name="StructureSummary" Visibility="Collapsed"/>
      <WrapPanel x:Name="ScopeActions" Visibility="Collapsed" Margin="0,8,0,0"><Button x:Name="IncludeParentButton" Content="상위 폴더 포함 ↑" Click="IncludeParent_Click" Padding="9,5" FontSize="12" Margin="0,0,6,0"/><Button x:Name="ResetScopeButton" Content="실행 폴더로 ↙" Click="ResetScope_Click" Padding="9,5" FontSize="12"/></WrapPanel>
      <Grid Margin="0,18,0,7"><TextBlock Text="별칭" FontWeight="SemiBold"/><TextBlock Text="선택 사항" HorizontalAlignment="Right" Foreground="#99A3B2" FontSize="11"/></Grid><TextBox x:Name="Alias" TextChanged="Alias_TextChanged" LostFocus="Alias_Changed" AutomationProperties.Name="별칭"/>
      <TextBlock Text="장르" FontWeight="SemiBold" Margin="0,17,0,7"/><WrapPanel x:Name="GenreChecks"/><StackPanel x:Name="GenreCreator"/>
      <TextBlock Text="카테고리" FontWeight="SemiBold" Margin="0,12,0,7"/><WrapPanel x:Name="CategoryChecks"/><StackPanel x:Name="CategoryCreator"/>
      <Expander Header="세부 정리" Foreground="#71839E" Margin="0,18,0,0"><StackPanel Margin="0,12,0,0">
       <TextBlock Text="실제 폴더명" Margin="0,0,0,7"/><TextBox x:Name="PhysicalName" TextChanged="Physical_TextChanged" LostFocus="Physical_Changed" AutomationProperties.Name="실제 폴더명"/>
       <TextBlock x:Name="NameWarning" Foreground="#A66C21" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
       <WrapPanel Margin="0,12,0,0"><Button x:Name="ContentToggle" Click="Content_Click" Margin="0,0,8,8"/><Button x:Name="RelationToggle" Click="Relation_Click" Margin="0,0,8,8"/><Button x:Name="SplitButton" Content="다른 게임 분리" Click="Split_Click" Margin="0,0,0,8"/></WrapPanel>
      </StackPanel></Expander>
     </StackPanel></ScrollViewer>
    </DockPanel></Border>
    <Border Grid.Column="4" Background="#F8FAFE" CornerRadius="12" BorderBrush="#E2E7F0" BorderThickness="1"><DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="18,20,18,16"><StackPanel Orientation="Horizontal"><Border Background="#EAF0FC" CornerRadius="6" Width="26" Height="26" Margin="0,0,9,0"><TextBlock Text="3" Foreground="#4269C7" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="보관함에 담기" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
      <Grid Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="DestinationLabel" Text="D:\IndieLibrary" FontSize="12" Foreground="#8490A2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Content="변경" Click="Destination_Click" FontSize="11" Padding="7,4" Margin="5,0,0,0"/></Grid>
     </StackPanel>
     <ScrollViewer><StackPanel Margin="14,0,14,16"><Border x:Name="DropZone" AllowDrop="True" DragOver="DropZone_Over" DragLeave="DropZone_Leave" Drop="DropZone_Drop" Background="#EDF2FC" BorderBrush="#C8D6EE" BorderThickness="1" CornerRadius="9" Padding="14,20"><StackPanel><TextBlock Text="↓" FontSize="29" Foreground="#688BCB" HorizontalAlignment="Center"/><TextBlock x:Name="DropTitle" Text="게임 카드를 여기에" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="드래그해서 담기" FontSize="12" Foreground="#8C9DB7" TextAlignment="Center" Margin="0,6,0,0"/></StackPanel></Border><TextBlock Text="이동 예정" Foreground="#8190A5" Margin="2,20,0,10" FontSize="12"/><StackPanel x:Name="PlannedList"/></StackPanel></ScrollViewer>
    </DockPanel></Border>
   </Grid>
   <Border x:Name="JobsPanel" Grid.Row="2" Visibility="Collapsed" Background="White" CornerRadius="12" Margin="28,0,28,20" Padding="28"><ScrollViewer><StackPanel x:Name="JobsContent"/></ScrollViewer></Border>
   <Border x:Name="TagsPanel" Grid.Row="2" Visibility="Collapsed" Background="White" CornerRadius="12" Margin="28,0,28,20" Padding="28"><ScrollViewer><StackPanel x:Name="TagsContent"/></ScrollViewer></Border>
   <Border Grid.Row="3" Background="White" BorderBrush="#E2E7F0" BorderThickness="0,1,0,0" Padding="28,14"><Grid><StackPanel VerticalAlignment="Center" Margin="0,0,320,0"><TextBlock x:Name="PlanCount" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="PlanHint" Foreground="#8A95A8" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel x:Name="FooterActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="되돌리기" Click="Undo_Click" Margin="0,0,12,0"/><Button x:Name="ReviewButton" Content="이동 계획 확인  →" Style="{StaticResource Primary}" Click="Review_Click" Padding="22,12"/></StackPanel></Grid></Border>
  </Grid>
 </Grid>
</Window>
