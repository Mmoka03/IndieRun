<Window x:Class="IndieRun.ExecutablePicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="실행 파일 선택" Width="740" Height="600" MinWidth="600" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Style="{DynamicResource {x:Type Window}}" Background="{DynamicResource Surface.Primary}">
 <Window.Resources>
  <Style x:Key="ExecutableCandidateItem" TargetType="ListBoxItem">
   <Setter Property="Background" Value="{DynamicResource Surface.Secondary}"/><Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><ContentPresenter/><Path x:Name="selected" Grid.Column="1" Data="M 0,5 L 4,9 L 12,0" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource Accent.Text}" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Accent.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent.Fill}"/><Setter TargetName="selected" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Border.Focus}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ExecutableList" TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/><Setter Property="ItemContainerStyle" Value="{StaticResource ExecutableCandidateItem}"/></Style>
 </Window.Resources>
 <Grid Margin="28" x:Name="Layout">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock x:Name="GameTitle" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
   <TextBlock Text="실행할 파일을 선택하세요." Foreground="{DynamicResource Text.Secondary}" Margin="0,6,0,0"/>
  </StackPanel>
  <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <StackPanel Margin="0,0,0,10"><TextBlock x:Name="CandidateCount" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" FontSize="12"/><ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Height="4" Margin="0,10,0,0" Foreground="{DynamicResource Accent.Fill}"/></StackPanel>
   <ListBox x:Name="MainCandidates" Style="{StaticResource ExecutableList}" SelectionChanged="Candidate_Changed" AutomationProperties.Name="게임 실행 후보"/>
   <Expander x:Name="AuxiliarySection" Header="보조 프로그램 추정" Foreground="{DynamicResource Text.Muted}" Visibility="Collapsed" Margin="0,8,0,0"><ListBox x:Name="AuxiliaryCandidates" Style="{StaticResource ExecutableList}" Margin="0,8,0,0" SelectionChanged="Candidate_Changed" AutomationProperties.Name="보조 프로그램 추정 목록"/></Expander>
  </StackPanel></ScrollViewer>
  <StackPanel x:Name="Footer" Grid.Row="2" Margin="0,16,0,0">
   <TextBlock x:Name="SelectedFile" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
   <TextBlock x:Name="Status" Foreground="{DynamicResource Warning.Text}" TextWrapping="Wrap" Margin="0,6,0,0"/>
   <Expander x:Name="Details" Header="자세히" Foreground="{DynamicResource Text.Muted}" Visibility="Collapsed" Margin="0,6,0,0"><ScrollViewer MaxHeight="95"><TextBox x:Name="DetailText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0,6,0,0"/></ScrollViewer></Expander>
   <DockPanel Margin="0,16,0,0" LastChildFill="False">
    <WrapPanel DockPanel.Dock="Left"><Button x:Name="BrowseButton" Content="직접 선택" Click="Browse_Click" Margin="0,0,8,0"/><Button Content="실행 설정" Click="Advanced_Click"/></WrapPanel>
    <WrapPanel DockPanel.Dock="Right"><Button Content="취소" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/><Button x:Name="LaunchButton" Content="저장 후 실행" Style="{StaticResource Primary}" IsDefault="True" IsEnabled="False" Click="Confirm_Click"/></WrapPanel>
   </DockPanel>
  </StackPanel>
 </Grid>
</Window>

