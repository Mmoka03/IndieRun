# Only project source directories and reviewed root files are eligible.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/global.json
!/README.md
!/CONTRIBUTING.md
!/AGENTS.md
!/.github/
!/src/
!/tests/
!/tools/
!/docs/

# Existing local audit reports stay on this PC.
/docs/*
!/docs/HISTORY.md
!/docs/DEVELOPMENT.md
!/docs/TESTING.md
!/docs/USER-GUIDE.md

**/bin/
**/obj/
**/.vs/
**/data/
**/backups/
**/Backups/
**/library/
**/Library/
**/scan-input/
**/MockData/
**/fixtures/
**/screens/
**/test-results/
**/node_modules/
**/.indierun*
**/workspace*.json
**/tags.json
**/player.json
*.user
*.exe
*.dll
*.pdb
*.zip
*.log
*.bak
.env
.env.*
*.pem
*.key
